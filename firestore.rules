rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: check if user is admin (by email in custom claims or ADMIN_EMAILS list)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email in ['admin@agniveshayurveda.com', 'drayan@agniveshayurveda.com', 'drswati@agniveshayurveda.com']
      );
    }
    
    // Public read, anyone can create appointments
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.patientUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // Public read for doctors, admin write
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Public read for specialities, admin write
    match /specialities/{specialityId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Public read for clinic info, admin write
    match /clinicInfo/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Users can read their own data, admin can read all
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
  }
}
