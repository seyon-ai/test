rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin = users/{uid}.role == "admin" in Firestore (set manually in Console)
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Appointments: patient sees own, admin sees all
    match /appointments/{appointmentId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.patientUid == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.patientUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // OPD schedule dates: public read (booking page), admin write
    match /opdSchedule/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /specialities/{specialityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clinicInfo/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users: own doc or admin. Users can NOT make themselves admin.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.role == 'user';
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }
  }
}
